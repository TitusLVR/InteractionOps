{
  "version": 1,
  "name": "falloff_tools",
  "title": "Falloff Tools",
  "space": "VIEW_3D",
  "rows": [
    {"type": "SECTION", "label": "Falloff Fields"},
    {"type": "ROW", "show_if": {"mode": "EDIT_MESH"}, "cells": [
      {"type": "BUTTON", "label": "Fit",   "op": "iops.mesh_falloff_fit"},
      {"type": "BUTTON", "label": "Clear", "op": "iops.mesh_falloff_clear"}
    ]},
    {"type": "ROW", "show_if": {"mode": "EDIT_MESH"}, "cells": [
      {"type": "BUTTON", "label": "Move",   "op": "iops.mesh_falloff_move"},
      {"type": "BUTTON", "label": "Rotate", "op": "iops.mesh_falloff_rotate"},
      {"type": "BUTTON", "label": "Scale",  "op": "iops.mesh_falloff_scale"}
    ]},
    {"type": "ROW", "show_if": {"mode": "EDIT_MESH"}, "cells": [
      {"type": "BUTTON", "label": "Normal Offset", "op": "iops.mesh_falloff_normal_offset"}
    ]},
    {"type": "ROW", "show_if": {"mode": "EDIT_MESH"}, "cells": [
      {"type": "BUTTON", "label": "Edge Slide",   "op": "iops.mesh_field_edge_slide"},
      {"type": "BUTTON", "label": "Offset Slide", "op": "iops.mesh_field_offset_edge_slide"}
    ]},
    {"type": "SECTION", "label": "Go to Edit Mesh mode", "show_if": {"mode": "OBJECT"}},
    {"type": "SECTION", "label": "Settings"},
    {"type": "DROPDOWN", "prop": "scene.IOPS.falloff.basis", "label": "Basis",
     "labels": {"LOCAL": "Local", "CURSOR": "Cursor", "WORLD": "World", "NORMAL": "Normal"}},
    {"type": "FLIPBOX", "prop": "scene.IOPS.falloff.show_weights", "label": "Weights"}
  ]
}
